generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  PSYCHIATRIST
  THERAPIST
}

enum CapacityStatus {
  AVAILABLE
  SOME_CAPACITY
  NO_CAPACITY
}

enum NotifyFrequency {
  DAILY
  WEEKDAYS
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         Role
  timezone     String   @default("Africa/Johannesburg")
  avatarUrl    String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  therapistProfile    TherapistProfile?
  psychiatristProfile PsychiatristProfile?
  pushSubscriptions   PushSubscription[]
  dailyAvailabilities DailyAvailability[]
  reminderLogs        ReminderLog[]
}

model TherapistProfile {
  id                 String   @id @default(cuid())
  userId             String   @unique
  specialty          String?
  hospital           String?
  ageGroups          String[] @default([])
  gender             String?
  languages          String[] @default([])
  areasOfPractice    String[] @default([])
  offersAssessments  Boolean?
  assessmentTypes    String[] @default([])
  bio                String?
  phone              String?
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PsychiatristProfile {
  id            String  @id @default(cuid())
  userId        String  @unique
  title         String?
  specialty     String?
  phone         String?
  secondaryPhone String?
  clinic        String?
  licenseNumber String?
  bio           String?
  user          User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model DailyAvailability {
  id          String         @id @default(cuid())
  therapistId String
  date        DateTime       @db.Date
  status      CapacityStatus
  slots       Int?
  updatedAt   DateTime       @updatedAt
  createdAt   DateTime       @default(now())
  therapist   User           @relation(fields: [therapistId], references: [id], onDelete: Cascade)

  @@unique([therapistId, date])
  @@index([date])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AppSettings {
  id                          String    @id @default("default")
  notifyEnabled               Boolean   @default(true)
  notifyBody                  String    @default("Hi {{name}} — please update today’s patient capacity.")
  psychiatristDefaultView     String    @default("table")
  psychiatristShowViewOptions Boolean   @default(false)
  psychiatristBoardFilters    Json      @default("[]")
  hpcsaCategories             Json      @default("[\"Clinical Psychologist\",\"Counselling Psychologist\",\"Educational Psychologist\",\"Neuropsychologist\"]")
  psychiatristProfileFields   Json      @default("[]")
  therapistProfileFields      Json      @default("[]")
  hospitalSettings            Json      @default("[\"Neuro Clinic - George\",\"Akeso - George\"]")
  ageGroupOptions             Json      @default("[]")
  genderOptions               Json      @default("[]")
  languageOptions             Json      @default("[]")
  practiceAreaOptions         Json      @default("[]")
  assessmentTypeOptions       Json      @default("[]")
  lastBroadcastAt             DateTime?
  updatedAt                   DateTime  @updatedAt
}

model NotificationAlert {
  id        String          @id @default(cuid())
  label     String
  timeLocal String
  frequency NotifyFrequency @default(DAILY)
  enabled   Boolean         @default(true)
  sortOrder Int             @default(0)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  reminders ReminderLog[]
}

model ReminderLog {
  id        String   @id @default(cuid())
  userId    String
  alertId   String
  date      DateTime @db.Date
  sentAt    DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  alert     NotificationAlert @relation(fields: [alertId], references: [id], onDelete: Cascade)

  @@unique([userId, alertId, date])
  @@index([alertId, date])
}
