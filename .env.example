# Local / Docker — copy to .env and fill in values
#
# Docker Compose overrides DATABASE_URL to use the internal `db` service.
# For non-Docker local Postgres on the host, use localhost and your own port.

DATABASE_URL="postgresql://referral:referral@localhost:5434/referral_hub?schema=public"
AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_URL="https://referralhub.streblainnovations.com"
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@streblainnovations.com"
CRON_SECRET="change-me"
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
